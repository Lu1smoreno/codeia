Private Sub ConfigurarHojas()
    Call CrearHojaSiNoExiste("Dashboard", False)
    Call CrearHojaSiNoExiste("Datos_Cliente", True)
    Call CrearHojaSiNoExiste("Inventario_Temp", True)
    Call CrearHojaSiNoExiste("Ventas_Temp", True)
    Call CrearHojaSiNoExiste("Comparativa_Temp", True)
    Call CrearHojaSiNoExiste("Precios_Netos", True)
    Call ConfigurarDashboard
End Sub

Private Sub CrearHojaSiNoExiste(nombreHoja As String, Optional ocultar As Boolean = False)
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = Worksheets(nombreHoja)
    On Error GoTo 0
    
    If ws Is Nothing Then
        Set ws = Worksheets.Add(After:=Worksheets(Worksheets.Count))
        ws.Name = nombreHoja
        If ocultar Then ws.Visible = xlSheetHidden
    End If
End Sub

Private Sub ConfigurarDashboard()
    Dim ws As Worksheet
    Set ws = Worksheets("Dashboard")
    
    ws.Cells.Clear
    
    With ws.Range("A1:H1")
        .Merge
        .Value = "SISTEMA DE GESTIÓN DE CLIENTES - VERSIÓN MEJORADA"
        .Font.Size = 18
        .Font.Bold = True
        .HorizontalAlignment = xlCenter
        .Interior.Color = RGB(54, 96, 146)
        .Font.Color = RGB(255, 255, 255)
    End With
    
    Call FormatearSeccion(ws.Range("A3"), "INFORMACIÓN DEL CLIENTE")
    ws.Range("A4").Value = "Código Cliente:"
    ws.Range("A5").Value = "Nombre Cliente:"
    ws.Range("A6").Value = "Última Actualización:"
    
    Call CrearBotonDashboard(ws, "B8", "Seleccionar Cliente", "MostrarFormularioPrincipal")
    Call CrearBotonDashboard(ws, "D8", "Procesar Todo", "ProcesarDatos")
    Call CrearBotonDashboard(ws, "F8", "Generar Reporte", "GenerarReporte")
    
    Call FormatearSeccion(ws.Range("A10"), "ESTADO DE ARCHIVOS IMPORTADOS")
    ws.Range("A11:A14").Value = [{"Inventario:"; "Ventas:"; "Comparativa:"; "Precios Netos:"}]
    
    Call FormatearSeccion(ws.Range("A16"), "INDICADORES CLAVE")
    ws.Range("A17:A20").Value = [{"Total Referencias (Inv.):"; "Valor Inventario (Neto):"; "Ventas Período (Neto):"; "Rotación Promedio:"}]
    
    Call FormatearSeccion(ws.Range("A22"), "RECOMENDACIONES DE PEDIDO")
    ws.Columns.AutoFit
End Sub

Private Sub FormatearSeccion(rango As Range, texto As String)
    With rango
        .Value = texto
        .Font.Bold = True
        .Interior.Color = RGB(217, 225, 242)
    End With
End Sub

Private Sub CrearBotonDashboard(ws As Worksheet, rango As String, texto As String, macro As String)
    Dim btn As Button
    On Error Resume Next
    ws.Buttons(texto).Delete
    On Error GoTo 0
    
    Set btn = ws.Buttons.Add(ws.Range(rango).Left, ws.Range(rango).Top, 120, 30)
    btn.Caption = texto
    btn.OnAction = macro
    btn.Name = texto
End Sub

' ##### Funciones y Subrutinas Principales del Sistema #####

Public Function BuscarCliente(ByVal codigoCliente As String) As String
    If listaClientes Is Nothing Then Call InicializarListaClientes
    If listaClientes.Exists(codigoCliente) Then
        BuscarCliente = listaClientes.Item(codigoCliente)
    Else
        BuscarCliente = ""
    End If
End Function

Public Sub MostrarFormularioPrincipal()
    On Error GoTo ErrorHandler
    UserForm1.Show
    Exit Sub
ErrorHandler:
    MsgBox "Error al mostrar el formulario: " & Err.Description, vbCritical
End Sub

Public Sub ActualizarInfoClienteDashboard(codigoClienteInput As String)
    Dim ws As Worksheet
    Set ws = Worksheets("Dashboard")
    
    clienteSeleccionado = UCase(Trim(codigoClienteInput))
    nombreCliente = BuscarCliente(clienteSeleccionado)
    
    ws.Range("B4").Value = clienteSeleccionado
    ws.Range("B5").Value = IIf(nombreCliente <> "", nombreCliente, "Cliente no encontrado.")
    ws.Range("B6").Value = IIf(nombreCliente <> "", Format(Now, "dd/mm/yyyy hh:mm"), "")
    
    If nombreCliente <> "" Then
        MsgBox "Cliente encontrado: " & nombreCliente, vbInformation
    Else
        MsgBox "Cliente no encontrado.", vbExclamation
    End If
End Sub

' ##### Subrutinas de Manipulación de Archivos #####

Sub ImportarInventario()
    Call ImportarArchivoGenerico("Inventario")
End Sub

Sub ImportarVentas()
    Call ImportarArchivoGenerico("Ventas")
End Sub

Sub ImportarComparativa()
    Call ImportarArchivoGenerico("Comparativa por zonas")
End Sub

Sub ImportarPreciosNetos()
    Call ImportarArchivoGenerico("Precios Netos")
End Sub

Private Sub ImportarArchivoGenerico(tipoArchivo As String)
    Dim rutaArchivo As String
    Dim wsDestino As Worksheet
    
    Select Case tipoArchivo
        Case "Inventario": Set wsDestino = Worksheets("Inventario_Temp"): rutaArchivo = Application.GetOpenFilename("Archivos Excel (*.xls*), *.xls*", , "Seleccionar archivo de Inventario")
        Case "Ventas": Set wsDestino = Worksheets("Ventas_Temp"): rutaArchivo = Application.GetOpenFilename("Archivos Excel (*.xls*), *.xls*", , "Seleccionar archivo de Ventas")
        Case "Comparativa por zonas": Set wsDestino = Worksheets("Comparativa_Temp"): rutaArchivo = Application.GetOpenFilename("Archivos Excel (*.xls*), *.xls*", , "Seleccionar archivo de Comparativa por Zonas")
        Case "Precios Netos": Set wsDestino = Worksheets("Precios_Netos"): rutaArchivo = Application.GetOpenFilename("Archivos Excel (*.xls*), *.xls*", , "Seleccionar archivo de Precios Netos")
    End Select
    
    If rutaArchivo = "False" Then Exit Sub
    
    Dim wb As Workbook, wsOrigen As Worksheet
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    On Error GoTo ErrorHandler
    Set wb = Workbooks.Open(rutaArchivo, ReadOnly:=True, UpdateLinks:=False)
    Set wsOrigen = wb.ActiveSheet
    wsDestino.Cells.Clear
    wsOrigen.UsedRange.Copy wsDestino.Range("A1")
    wb.Close False
    
    Select Case tipoArchivo
        Case "Inventario": rutaInventario = rutaArchivo
        Case "Ventas": rutaVentas = rutaArchivo
        Case "Comparativa por zonas": rutaComparativa = rutaArchivo
        Case "Precios Netos": rutaPreciosNetos = rutaArchivo
    End Select
    
    Call ActualizarEstadoArchivos
    
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    MsgBox tipoArchivo & " importado correctamente desde: " & rutaArchivo, vbInformation
    Exit Sub
    
ErrorHandler:
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    If Not wb Is Nothing Then wb.Close False
    MsgBox "Error al importar " & tipoArchivo & ": " & Err.Description, vbCritical, "Error de Importación"
End Sub

