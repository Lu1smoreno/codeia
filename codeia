<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Panel de Control de Inventario y Recomendaciones</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; background: #f4f6fa; }
    header { background: #446ccc; color: #fff; padding: 1.5em 2em; }
    main { max-width: 1200px; margin: 2em auto; background: #fff; border-radius: 12px; box-shadow: 0 2px 12px #8882; }
    section { padding: 2em; }
    table { border-collapse: collapse; width: 100%; font-size: 15px; }
    th, td { padding: 8px 12px; border-bottom: 1px solid #eee; }
    th { background: #446ccc; color: #fff; }
    tr:nth-child(even) { background: #f4f6fa; }
    .alert { font-weight: bold; padding: 4px 8px; border-radius: 6px; display: inline-block; }
    .urgente { background: #ff6464; color: #222; }
    .critico { background: #ffbc64; color: #222; }
    .bajo { background: #ffff64; color: #222; }
    .optimo { background: #64ff64; color: #222; }
    .lento { background: #cccccc; color: #222; }
    .sinventas { background: #b4b4b4; color: #222; }
    .kpis > div { display: inline-block; margin: 0 2em 1em 0; }
    footer { text-align: center; padding: 2em; color: #999; }
    @media (max-width: 700px) {
      main, section { padding: 1em; }
      table, th, td { font-size: 13px; }
    }
  </style>
</head>
<body>
  <header>
    <h1>Panel de Control de Inventario y Recomendaciones</h1>
  </header>
  <main>
    <section>
      <h2>Paso 1: Seleccione Cliente</h2>
      <input type="text" id="clienteCodigo" placeholder="Código de cliente" style="font-size:16px;padding:6px;">
      <input type="text" id="clienteNombre" placeholder="Nombre del cliente" style="font-size:16px;margin-left:16px;padding:6px;">
    </section>
    <section>
      <h2>Paso 2: Suba sus archivos Excel</h2>
      <label>Inventario: <input type="file" id="fileInventario" accept=".xlsx,.xls,.csv"></label>
      <label style="margin-left:16px;">Ventas: <input type="file" id="fileVentas" accept=".xlsx,.xls,.csv"></label>
      <label style="margin-left:16px;">Comparativa: <input type="file" id="fileComparativa" accept=".xlsx,.xls,.csv"></label>
      <button id="btnProcesar" style="margin-left:30px;padding:0.5em 1.2em;font-size:17px;background:#446ccc;color:#fff;border:none;border-radius:6px;">
        Procesar Datos
      </button>
    </section>
    <section id="kpisSection" style="display:none;">
      <h2>KPIs Generales</h2>
      <div class="kpis" id="kpis"></div>
    </section>
    <section id="recsSection" style="display:none;">
      <h2>Recomendaciones de Pedido</h2>
      <table id="tablaRecs">
        <thead>
          <tr>
            <th>Código</th>
            <th>Descripción</th>
            <th>Stock</th>
            <th>Coste</th>
            <th>Venta</th>
            <th>Ventas Cliente</th>
            <th>Ventas Mercado</th>
            <th>Recomendación</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </section>
  </main>
  <footer>
    &copy; <span id="year"></span> - Sistema de Recomendaciones Visual &mdash; Adaptado de VBA a Web
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
    let inventario = [], ventas = [], comparativa = [];

    function leerArchivo(input, callback) {
      const file = input.files[0];
      if (!file) return callback([]);
      const reader = new FileReader();
      reader.onload = e => {
        let data = new Uint8Array(e.target.result);
        let workbook = XLSX.read(data, {type: 'array'});
        let sheet = workbook.Sheets[workbook.SheetNames[0]];
        callback(XLSX.utils.sheet_to_json(sheet, {header:1}));
      };
      reader.readAsArrayBuffer(file);
    }

    document.getElementById('fileInventario').addEventListener('change', e => {
      leerArchivo(e.target, data => { inventario = data; });
    });
    document.getElementById('fileVentas').addEventListener('change', e => {
      leerArchivo(e.target, data => { ventas = data; });
    });
    document.getElementById('fileComparativa').addEventListener('change', e => {
      leerArchivo(e.target, data => { comparativa = data; });
    });

    document.getElementById('btnProcesar').onclick = function() {
      const clienteCodigo = document.getElementById('clienteCodigo').value.trim();
      const clienteNombre = document.getElementById('clienteNombre').value.trim();
      if (!clienteCodigo || !clienteNombre || !inventario.length || !ventas.length || !comparativa.length) {
        alert("Por favor, complete cliente y cargue los tres archivos.");
        return;
      }
      // Procesamiento de KPIs y recomendaciones
      let totalRefs = inventario.length - 1;
      let valorInventario = 0, stockMuerto = 0, stockCritico = 0, ventasNeto = 0, ventasTotalesComp = 0, margenTotal = 0, contadorMargen = 0;
      let recs = [];
      const IDX = { COD: 0, DESC: 1, STOCK: 2, COSTE: 3, VENTA: 4 };
      let ventasMap = {}, compMap = {};
      ventas.slice(1).forEach(row => ventasMap[row[0]] = row[2]);
      comparativa.slice(1).forEach(row => compMap[row[0]] = row[2]);
      inventario.slice(1).forEach(row => {
        let stock = Number(row[IDX.STOCK]) || 0;
        let coste = Number(row[IDX.COSTE]) || 0;
        let venta = Number(row[IDX.VENTA]) || 0;
        let ventasCliente = Number(ventasMap[row[IDX.COD]]) || 0;
        let ventasMercado = Number(compMap[row[IDX.COD]]) || 0;
        valorInventario += stock * coste;
        if (stock === 0) stockMuerto++;
        if (stock > 0 && stock < 5) stockCritico++;
        ventasNeto += ventasCliente * venta;
        if (venta > 0) {
          margenTotal += (venta - coste) / venta;
          contadorMargen++;
        }
        let alertClass = '', alertLabel = '';
        if (ventasCliente === 0)      { alertClass = 'sinventas'; alertLabel = '❌ SIN VENTAS'; }
        else if (stock === 0) {
          if (ventasCliente >= 10)    { alertClass = 'urgente'; alertLabel = '?? URGENTE'; }
          else if (ventasCliente >= 3){ alertClass = 'critico'; alertLabel = '? CRÍTICO'; }
          else                        { alertClass = 'bajo'; alertLabel = '? BAJO STOCK'; }
        }
        else if (stock < 3 && ventasCliente > 0) { alertClass = 'bajo'; alertLabel = '? BAJO STOCK'; }
        else if (ventasCliente / (stock||1) > 3) { alertClass = 'optimo'; alertLabel = '✔️ ÓPTIMO'; }
        else if (ventasCliente < 2)              { alertClass = 'lento'; alertLabel = 'ℹ️ LENTO'; }
        else                                     { alertClass = 'optimo'; alertLabel = '✔️ ÓPTIMO'; }
        recs.push({ cod: row[IDX.COD], desc: row[IDX.DESC], stock, coste, venta, ventasCliente, ventasMercado, alertClass, alertLabel });
      });
      ventasTotalesComp = comparativa.slice(1).reduce((a, row) => a + (Number(row[2]) * Number(row[3]||1)), 0);
      let kpis = {
        totalRefs, valorInventario, ventasNeto, stockMuerto, stockCritico,
        cuota: ventasTotalesComp ? (ventasNeto / ventasTotalesComp * 100).toFixed(2) + "%" : "N/A",
        margen: contadorMargen ? (margenTotal / contadorMargen * 100).toFixed(2) + "%" : "N/A"
      };
      // Mostrar KPIs
      document.getElementById('kpisSection').style.display = '';
      document.getElementById('kpis').innerHTML =
        `<div><b>Cliente:</b> ${clienteCodigo} - ${clienteNombre}</div>
         <div><b>Referencias:</b> ${kpis.totalRefs}</div>
         <div><b>Valor Inventario:</b> ${kpis.valorInventario.toLocaleString("es-ES", { minimumFractionDigits: 2 })}</div>
         <div><b>Ventas Neto:</b> ${kpis.ventasNeto.toLocaleString("es-ES", { minimumFractionDigits: 2 })}</div>
         <div><b>Stock Muerto:</b> ${kpis.stockMuerto}</div>
         <div><b>Stock Crítico:</b> ${kpis.stockCritico}</div>
         <div><b>Cuota vs Mercado:</b> ${kpis.cuota}</div>
         <div><b>Margen Promedio:</b> ${kpis.margen}</div>`;
      // Mostrar Recomendaciones
      document.getElementById('recsSection').style.display = '';
      let tbody = document.getElementById('tablaRecs').querySelector('tbody');
      tbody.innerHTML = '';
      recs.forEach(r => {
        let tr = document.createElement('tr');
        tr.innerHTML = `<td>${r.cod}</td><td>${r.desc}</td><td>${r.stock}</td>
          <td>${r.coste}</td><td>${r.venta}</td><td>${r.ventasCliente}</td>
          <td>${r.ventasMercado}</td>
          <td><span class="alert ${r.alertClass}">${r.alertLabel}</span></td>`;
        tbody.appendChild(tr);
      });
    };
  </script>
</body>
</html>
