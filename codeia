Private Sub ActualizarEstadoArchivos()
    Dim wsDash As Worksheet
    Set wsDash = Worksheets("Dashboard")
    
    Dim estadoImportado As String: estadoImportado = "? Importado"
    Dim estadoPendiente As String: estadoPendiente = "? Pendiente"
    
    wsDash.Range("B11").Value = IIf(rutaInventario <> "", estadoImportado, estadoPendiente)
    wsDash.Range("B12").Value = IIf(rutaVentas <> "", estadoImportado, estadoPendiente)
    wsDash.Range("B13").Value = IIf(rutaComparativa <> "", estadoImportado, estadoPendiente)
    wsDash.Range("B14").Value = IIf(rutaPreciosNetos <> "", estadoImportado, estadoPendiente)
End Sub

' ##### Subrutina para Generar Reportes #####

Public Sub GenerarReporte()
    If clienteSeleccionado = "" Then
        MsgBox "Seleccione un cliente primero.", vbExclamation
        Exit Sub
    End If
    
    Dim rutaReporte As String
    Dim nombreArchivo As String
    nombreArchivo = "Reporte_" & clienteSeleccionado & "_" & Replace(nombreCliente, " ", "_") & "_" & Format(Date, "yyyymmdd") & ".xlsx"
    nombreArchivo = Application.GetSaveAsFilename(nombreArchivo, "Archivos Excel (*.xlsx), *.xlsx")
    
    If nombreArchivo = "False" Then Exit Sub
    
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    On Error GoTo ErrorHandler
    ThisWorkbook.SaveCopyAs nombreArchivo
    
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    MsgBox "Reporte generado exitosamente en: " & nombreArchivo, vbInformation
    Exit Sub
    
ErrorHandler:
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    MsgBox "Error al generar el reporte: " & Err.Description, vbCritical
End Sub

