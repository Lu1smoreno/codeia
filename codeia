Private Sub CommandButton9_Click() ' Botón 'GENERAR REPORTE' (asumiendo este nombre para el botón visible en la imagen)
    On Error GoTo ErrorHandler
    Application.StatusBar = "Generando y enviando reporte..."
    Call GenerarReporte ' Llama a la subrutina para generar el reporte
    MsgBox "Reporte generado y listo. Se ha preparado el email (si configurado).", vbInformation, "Reporte Generado"
    Application.StatusBar = False
    Exit Sub
ErrorHandler:
    MsgBox "Ocurrió un error al generar el reporte. Verifique la configuración de email y los datos.", vbCritical, "Error al Generar Reporte"
    Application.StatusBar = False
End Sub

