Private Sub ConfigurarHojas()
    Call CrearHojaSiNoExiste("Dashboard", False)
    Call CrearHojaSiNoExiste("Datos_Cliente", True)
    Call CrearHojaSiNoExiste("Inventario_Temp", True)
    Call CrearHojaSiNoExiste("Ventas_Temp", True)
    Call CrearHojaSiNoExiste("Comparativa_Temp", True)
End Sub

Private Sub CrearHojaSiNoExiste(nombreHoja As String, Optional ocultar As Boolean = False)
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = Worksheets(nombreHoja)
    On Error GoTo 0
    If ws Is Nothing Then
        Set ws = Worksheets.Add(After:=Worksheets(Worksheets.Count))
        ws.Name = nombreHoja
        If ocultar Then ws.Visible = xlSheetHidden
    End If
End Sub

Public Function BuscarCliente(ByVal codigoCliente As String) As String
    If listaClientes Is Nothing Then Call InicializarListaClientes
    If listaClientes.Exists(codigoCliente) Then
        BuscarCliente = listaClientes.Item(codigoCliente)
    Else
        BuscarCliente = ""
    End If
End Function

Public Sub ImportarInventario()
    Call ImportarArchivoGenerico("Inventario")
End Sub

Public Sub ImportarVentas()
    Call ImportarArchivoGenerico("Ventas")
End Sub

Public Sub ImportarComparativa()
    Call ImportarArchivoGenerico("Comparativa")
End Sub

Private Sub ImportarArchivoGenerico(tipoArchivo As String)
    Dim rutaArchivo As Variant
    Dim wsDestino As Worksheet
    Select Case tipoArchivo
        Case "Inventario": Set wsDestino = Worksheets("Inventario_Temp"): rutaArchivo = Application.GetOpenFilename("Archivos Excel (*.xls*), *.xls*", , "Seleccionar archivo de Inventario")
        Case "Ventas": Set wsDestino = Worksheets("Ventas_Temp"): rutaArchivo = Application.GetOpenFilename("Archivos Excel (*.xls*), *.xls*", , "Seleccionar archivo de Ventas")
        Case "Comparativa": Set wsDestino = Worksheets("Comparativa_Temp"): rutaArchivo = Application.GetOpenFilename("Archivos Excel (*.xls*), *.xls*", , "Seleccionar archivo de Comparativa")
        Case Else: MsgBox "Tipo de archivo no reconocido.", vbCritical: Exit Sub
    End Select
    If rutaArchivo = False Then Exit Sub
    Dim wb As Workbook, wsOrigen As Worksheet
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    On Error GoTo ErrorHandler
    Set wb = Workbooks.Open(rutaArchivo, ReadOnly:=True, UpdateLinks:=False)
    Set wsOrigen = wb.Sheets(1)
    wsDestino.Cells.Clear
    wsOrigen.UsedRange.Copy wsDestino.Range("A1")
    wb.Close False
    Select Case tipoArchivo
        Case "Inventario": rutaInventario = rutaArchivo
        Case "Ventas": rutaVentas = rutaArchivo
        Case "Comparativa": rutaComparativa = rutaArchivo
    End Select
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    MsgBox tipoArchivo & " importado correctamente desde: " & rutaArchivo, vbInformation
    Exit Sub
ErrorHandler:
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    If Not wb Is Nothing Then wb.Close False
    MsgBox "Error al importar " & tipoArchivo & ": " & Err.Description, vbCritical, "Error de Importación"
End Sub

Public Sub ProcesarDatos()
    If clienteSeleccionado = "" Then
        MsgBox "Seleccione un cliente primero.", vbExclamation
        Exit Sub
    End If
    If rutaInventario = "" Or rutaVentas = "" Or rutaComparativa = "" Then
        MsgBox "Importe todos los archivos necesarios.", vbExclamation
        Exit Sub
    End If
    
    ' Rellenar información del cliente en el dashboard
    Dim wsDash As Worksheet
    Set wsDash = Worksheets("Dashboard")
    wsDash.Range("B4").Value = clienteSeleccionado
    wsDash.Range("B5").Value = nombreCliente
    wsDash.Range("B6").Value = Format(Now, "dd/mm/yyyy HH:MM")
    
    ' KPIs mejorados
    Dim wsInv As Worksheet, wsVentas As Worksheet, wsComp As Worksheet
    Set wsInv = Worksheets("Inventario_Temp")
    Set wsVentas = Worksheets("Ventas_Temp")
    Set wsComp = Worksheets("Comparativa_Temp")
    
    Dim totalRefs As Long, valorInventario As Double, ventasNeto As Double, rotacionPromedio As Double
    Dim stockMuerto As Long, stockCritico As Long, ventasTotalesComp As Double
    Dim i As Long, stock, precio, cantidadVendida
    
    ' Calcular KPIs básicos
    totalRefs = Application.CountA(wsInv.Range("A:A")) - 1
    valorInventario = 0
    stockMuerto = 0
    stockCritico = 0
    
    For i = 2 To wsInv.Cells(wsInv.Rows.Count, 1).End(xlUp).Row
        stock = wsInv.Cells(i, 3).Value         ' Columna C: Cantidad en Stock
        precio = wsInv.Cells(i, 4).Value        ' Columna D: Precio Neto
        If IsNumeric(stock) And IsNumeric(precio) Then
            valorInventario = valorInventario + (stock * precio)
            If stock = 0 Then stockMuerto = stockMuerto + 1
            If stock > 0 And stock < 5 Then stockCritico = stockCritico + 1
        End If
    Next i
    
    ventasNeto = 0
    For i = 2 To wsVentas.Cells(wsVentas.Rows.Count, 1).End(xlUp).Row
        cantidadVendida = wsVentas.Cells(i, 3).Value ' Columna C: Cantidad Vendida
        precio = wsVentas.Cells(i, 4).Value          ' Columna D: Precio Neto Venta
        If IsNumeric(cantidadVendida) And IsNumeric(precio) Then
            ventasNeto = ventasNeto + (cantidadVendida * precio)
        End If
    Next i
    
    ' Calcular ventas totales de comparativa
    ventasTotalesComp = 0
    For i = 2 To wsComp.Cells(wsComp.Rows.Count, 1).End(xlUp).Row
        cantidadVendida = wsComp.Cells(i, 3).Value
        precio = wsComp.Cells(i, 4).Value
        If IsNumeric(cantidadVendida) And IsNumeric(precio) Then
            ventasTotalesComp = ventasTotalesComp + (cantidadVendida * precio)
        End If
    Next i
    
    If valorInventario > 0 Then
        rotacionPromedio = ventasNeto / valorInventario
    Else
        rotacionPromedio = 0
    End If

    ' Actualizar dashboard con KPIs expandidos
    wsDash.Range("B17").Value = totalRefs
    wsDash.Range("B18").Value = Format(valorInventario, "#,##0.00")
    wsDash.Range("B19").Value = Format(ventasNeto, "#,##0.00")
    wsDash.Range("B20").Value = Format(rotacionPromedio, "0.00")
    
    ' Nuevos KPIs
    If wsDash.Range("A21").Value = "" Then
        wsDash.Range("A21").Value = "Referencias Sin Stock:"
        wsDash.Range("A22").Value = "Referencias Stock Crítico:"
        wsDash.Range("A23").Value = "Cuota vs Comparativa:"
        wsDash.Range("A24").Value = "Margen Promedio:"
    End If
    
    wsDash.Range("B21").Value = stockMuerto
    wsDash.Range("B22").Value = stockCritico
    If ventasTotalesComp > 0 Then
        wsDash.Range("B23").Value = Format((ventasNeto / ventasTotalesComp) * 100, "0.00") & "%"
    Else
        wsDash.Range("B23").Value = "N/A"
    End If
    
    ' Calcular margen promedio
    Dim margenTotal As Double, contadorMargen As Long
    margenTotal = 0
    contadorMargen = 0
    For i = 2 To wsInv.Cells(wsInv.Rows.Count, 1).End(xlUp).Row
        Dim precioCompra, precioVenta
        precioCompra = wsInv.Cells(i, 4).Value  ' Precio de coste
        precioVenta = wsInv.Cells(i, 5).Value   ' Precio de venta (si existe)
        If IsNumeric(precioCompra) And IsNumeric(precioVenta) And precioVenta > 0 Then
            margenTotal = margenTotal + ((precioVenta - precioCompra) / precioVenta)
            contadorMargen = contadorMargen + 1
        End If
    Next i
    
    If contadorMargen > 0 Then
        wsDash.Range("B24").Value = Format((margenTotal / contadorMargen) * 100, "0.00") & "%"
    Else
        wsDash.Range("B24").Value = "N/A"
    End If
    
    ' Generar análisis de recomendaciones
    Dim recomendacion As String
    recomendacion = "ANÁLISIS AUTOMÁTICO:" & vbCrLf & vbCrLf
    
    If rotacionPromedio < 1 Then
        recomendacion = recomendacion & "?? ROTACIÓN BAJA: " & Format(rotacionPromedio, "0.00") & " - Revisar estrategia de compras" & vbCrLf
    ElseIf rotacionPromedio > 4 Then
        recomendacion = recomendacion & "?? ROTACIÓN ALTA: " & Format(rotacionPromedio, "0.00") & " - Considerar aumentar stock" & vbCrLf
    Else
        recomendacion = recomendacion & "? ROTACIÓN ÓPTIMA: " & Format(rotacionPromedio, "0.00") & vbCrLf
    End If
    
    If stockMuerto > totalRefs * 0.2 Then
        recomendacion = recomendacion & "? STOCK MUERTO ALTO: " & stockMuerto & " referencias sin stock" & vbCrLf
    End If
    
    If stockCritico > totalRefs * 0.15 Then
        recomendacion = recomendacion & "?? STOCK CRÍTICO: " & stockCritico & " referencias con menos de 5 unidades" & vbCrLf
    End If
    
    wsDash.Range("A26").Value = recomendacion

    ' Generar hoja de recomendación mejorada
    Call GenerarHojaRecomendacionAvanzada

    MsgBox "Procesamiento completado. Dashboard actualizado con análisis completo.", vbInformation
End Sub

Public Sub GenerarHojaRecomendacionAvanzada()
    Dim wsInv As Worksheet, wsVentas As Worksheet, wsComp As Worksheet, wsRec As Worksheet
    Dim ultInv As Long, ultVentas As Long, ultComp As Long, i As Long, filaActual As Long
    Dim dictVentas As Object, dictComparativa As Object
    
    Set wsInv = Worksheets("Inventario_Temp")
    Set wsVentas = Worksheets("Ventas_Temp")
    Set wsComp = Worksheets("Comparativa_Temp")
    
    ' Borrar hoja anterior si existe
    On Error Resume Next
    Application.DisplayAlerts = False
    Worksheets("Recomendacion_Pedido").Delete
    Application.DisplayAlerts = True
    On Error GoTo 0
    
    Set wsRec = Worksheets.Add(After:=Worksheets(Worksheets.Count))
    wsRec.Name = "Recomendacion_Pedido"
    
    ' Encabezados mejorados
    With wsRec.Range("A1:M1")
        .Value = Array("Código", "Descripción", "Stock Actual", "Precio Coste", "Precio Venta", _
                      "Ventas Cliente", "Ventas Mercado", "Rotación", "% Cuota", "Días Stock", _
                      "Clasificación ABC", "Recomendación", "Cantidad Sugerida")
        .Font.Bold = True
        .Interior.Color = RGB(68, 114, 196)
        .Font.Color = RGB(255, 255, 255)
    End With
    
    ' Construir diccionarios de ventas
    Set dictVentas = CreateObject("Scripting.Dictionary")
    Set dictComparativa = CreateObject("Scripting.Dictionary")
    
    ultVentas = wsVentas.Cells(wsVentas.Rows.Count, 1).End(xlUp).Row
    For i = 2 To ultVentas
        Dim codigoProd As String
        codigoProd = CStr(wsVentas.Cells(i, 1).Value)
        If Not dictVentas.Exists(codigoProd) Then
            dictVentas(codigoProd) = wsVentas.Cells(i, 3).Value ' Cantidad Vendida
        Else
            dictVentas(codigoProd) = dictVentas(codigoProd) + wsVentas.Cells(i, 3).Value
        End If
    Next i
    
    ultComp = wsComp.Cells(wsComp.Rows.Count, 1).End(xlUp).Row
    For i = 2 To ultComp
        codigoProd = CStr(wsComp.Cells(i, 1).Value)
        If Not dictComparativa.Exists(codigoProd) Then
            dictComparativa(codigoProd) = wsComp.Cells(i, 3).Value ' Cantidad Vendida Mercado
        Else
            dictComparativa(codigoProd) = dictComparativa(codigoProd) + wsComp.Cells(i, 3).Value
        End If
    Next i
    
    ' Procesar cada producto del inventario
    ultInv = wsInv.Cells(wsInv.Rows.Count, 1).End(xlUp).Row
    filaActual = 2
    
    For i = 2 To ultInv
        Dim cod As String, desc As String
        Dim stock As Double, precioCoste As Double, precioVenta As Double
        Dim ventasCliente As Double, ventasMercado As Double, rotacion As Double
        Dim cuotaMercado As Double, diasStock As Long
        Dim clasificacionABC As String, recomendacion As String, cantidadSugerida As Long
        
        ' Datos básicos
        cod = CStr(wsInv.Cells(i, 1).Value)
        desc = CStr(wsInv.Cells(i, 2).Value)
        stock = Val(wsInv.Cells(i, 3).Value)
        precioCoste = Val(wsInv.Cells(i, 4).Value)
        precioVenta = Val(wsInv.Cells(i, 5).Value) ' Asumiendo que existe columna E con precio venta
        
        ' Ventas
        If dictVentas.Exists(cod) Then
            ventasCliente = dictVentas(cod)
        Else
            ventasCliente = 0
        End If
        
        If dictComparativa.Exists(cod) Then
            ventasMercado = dictComparativa(cod)
        Else
            ventasMercado = 0
        End If
        
        ' Cálculos avanzados
        If stock > 0 And ventasCliente > 0 Then
            rotacion = ventasCliente / stock
            diasStock = Int(30 / (ventasCliente / 30)) ' Estimación días que durará el stock
        ElseIf ventasCliente > 0 Then
            rotacion = 999 ' Indicador de que se vende pero no hay stock
            diasStock = 0
        Else
            rotacion = 0
            diasStock = 999
        End If
        
        ' Cuota de mercado
        If ventasMercado > 0 Then
            cuotaMercado = (ventasCliente / ventasMercado) * 100
        Else
            cuotaMercado = 0
        End If
        
        ' Clasificación ABC basada en ventas
        If ventasCliente >= 20 Then
            clasificacionABC = "A - Alto"
        ElseIf ventasCliente >= 5 Then
            clasificacionABC = "B - Medio"
        ElseIf ventasCliente > 0 Then
            clasificacionABC = "C - Bajo"
        Else
            clasificacionABC = "D - Sin ventas"
        End If
        
        ' Lógica de recomendación mejorada
        cantidadSugerida = 0
        If ventasCliente = 0 Then
            recomendacion = "?? SIN VENTAS - No pedir"
        ElseIf stock = 0 Then
            If ventasCliente >= 10 Then
                recomendacion = "?? URGENTE - Stock agotado con demanda alta"
                cantidadSugerida = Application.WorksheetFunction.Max(ventasCliente * 2, 10)
            ElseIf ventasCliente >= 3 Then
                recomendacion = "?? CRÍTICO - Reponer stock"
                cantidadSugerida = Application.WorksheetFunction.Max(ventasCliente * 1.5, 5)
            Else
                recomendacion = "? PEDIR - Baja demanda"
                cantidadSugerida = 3
            End If
        ElseIf stock < 3 And ventasCliente > 0 Then
            recomendacion = "?? BAJO STOCK - Aumentar pedido"
            cantidadSugerida = Application.WorksheetFunction.Max((ventasCliente * 2) - stock, 5)
        ElseIf diasStock < 15 And ventasCliente >= 5 Then
            recomendacion = "? STOCK < 15 DÍAS - Pedir pronto"
            cantidadSugerida = ventasCliente
        ElseIf rotacion > 3 Then
            recomendacion = "?? ALTA ROTACIÓN - Optimizar stock"
            cantidadSugerida = Int(ventasCliente * 0.5)
        ElseIf diasStock > 60 Then
            recomendacion = "?? STOCK LENTO - No pedir"
        Else
            recomendacion = "? STOCK ÓPTIMO"
        End If
        
        ' Escribir datos en la hoja
        wsRec.Cells(filaActual, 1).Value = cod
        wsRec.Cells(filaActual, 2).Value = desc
        wsRec.Cells(filaActual, 3).Value = stock
        wsRec.Cells(filaActual, 4).Value = Format(precioCoste, "0.00")
        wsRec.Cells(filaActual, 5).Value = Format(precioVenta, "0.00")
        wsRec.Cells(filaActual, 6).Value = ventasCliente
        wsRec.Cells(filaActual, 7).Value = ventasMercado
        wsRec.Cells(filaActual, 8).Value = Format(rotacion, "0.00")
        wsRec.Cells(filaActual, 9).Value = Format(cuotaMercado, "0.0") & "%"
        wsRec.Cells(filaActual, 10).Value = IIf(diasStock = 999, "8", diasStock)
        wsRec.Cells(filaActual, 11).Value = clasificacionABC
        wsRec.Cells(filaActual, 12).Value = recomendacion
        wsRec.Cells(filaActual, 13).Value = cantidadSugerida
        
        filaActual = filaActual + 1
    Next i
    
    ' Formatear la hoja
    With wsRec
        .Columns.AutoFit
        .Range("A1:M" & filaActual - 1).Borders.LineStyle = xlContinuous
        
        ' Formato condicional para recomendaciones
        Dim rngRecomendacion As Range
        Set rngRecomendacion = .Range("L2:L" & filaActual - 1)
        
        ' Aplicar colores según tipo de recomendación
        For i = 2 To filaActual - 1
            If InStr(.Cells(i, 12).Value, "??") > 0 Then
                .Cells(i, 12).Interior.Color = RGB(255, 100, 100) ' Rojo urgente
            ElseIf InStr(.Cells(i, 12).Value, "??") > 0 Then
                .Cells(i, 12).Interior.Color = RGB(255, 200, 100) ' Naranja crítico
            ElseIf InStr(.Cells(i, 12).Value, "?") > 0 Then
                .Cells(i, 12).Interior.Color = RGB(100, 255, 100) ' Verde óptimo
            ElseIf InStr(.Cells(i, 12).Value, "??") > 0 Then
                .Cells(i, 12).Interior.Color = RGB(200, 200, 200) ' Gris sin ventas
            End If
        Next i
        
        ' Freeze panes
        .Range("A2").Select
        ActiveWindow.FreezePanes = True
    End With
    
    ' Crear resumen en la parte superior
    wsRec.Range("O1").Value = "RESUMEN EJECUTIVO"
    wsRec.Range("O1").Font.Bold = True
    wsRec.Range("O1").Font.Size = 14
    
    Dim contUrgente As Long, contCritico As Long, contOptimo As Long, contSinVentas As Long
    For i = 2 To filaActual - 1
        If InStr(wsRec.Cells(i, 12).Value, "??") > 0 Then contUrgente = contUrgente + 1
        If InStr(wsRec.Cells(i, 12).Value, "??") > 0 Then contCritico = contCritico + 1
        If InStr(wsRec.Cells(i, 12).Value, "?") > 0 Then contOptimo = contOptimo + 1
        If InStr(wsRec.Cells(i, 12).Value, "??") > 0 Then contSinVentas = contSinVentas + 1
    Next i
    
    wsRec.Range("O3").Value = "?? Urgentes: " & contUrgente
    wsRec.Range("O4").Value = "?? Críticos: " & contCritico
    wsRec.Range("O5").Value = "? Óptimos: " & contOptimo
    wsRec.Range("O6").Value = "?? Sin ventas: " & contSinVentas
    
    MsgBox "Hoja de recomendación generada con análisis completo de " & (filaActual - 2) & " productos.", vbInformation
End Sub

Public Sub GenerarReporte()
    If clienteSeleccionado = "" Then
        MsgBox "Seleccione un cliente primero.", vbExclamation
        Exit Sub
    End If

    Dim nombreArchivo As Variant
    nombreArchivo = Application.GetSaveAsFilename("Reporte_Completo_" & clienteSeleccionado & "_" & Replace(nombreCliente, " ", "_") & "_" & Format(Date, "yyyymmdd") & ".xlsx", "Archivos Excel (*.xlsx), *.xlsx")
    If nombreArchivo = False Then Exit Sub

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    On Error GoTo ErrorHandler
    Dim wbReporte As Workbook
    Set wbReporte = Workbooks.Add
    
    ' Copiar hojas relevantes al reporte
    ThisWorkbook.Sheets("Dashboard").Copy Before:=wbReporte.Sheets(1)
    ThisWorkbook.Sheets("Recomendacion_Pedido").Copy Before:=wbReporte.Sheets(1)
    
    ' Eliminar hojas en blanco del reporte
    Dim s As Worksheet
    For Each s In wbReporte.Worksheets
        If s.Name <> "Dashboard" And s.Name <> "Recomendacion_Pedido" Then
            Application.DisplayAlerts = False
            s.Delete
            Application.DisplayAlerts = True
        End If
    Next s
    
    ' Hacer visibles las hojas copiadas
    wbReporte.Sheets("Dashboard").Visible = xlSheetVisible
    wbReporte.Sheets("Recomendacion_Pedido").Visible = xlSheetVisible
    
    wbReporte.SaveAs nombreArchivo, FileFormat:=xlOpenXMLWorkbook
    wbReporte.Close False

    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    MsgBox "Reporte completo generado exitosamente en: " & nombreArchivo, vbInformation
    Exit Sub

ErrorHandler:
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    MsgBox "Error al generar el reporte: " & Err.Description, vbCritical
End Sub

