Public Sub ProcesarDatos()
    If clienteSeleccionado = "" Then
        MsgBox "Seleccione un cliente primero.", vbExclamation
        Exit Sub
    End If
    
    If rutaInventario = "" Or rutaVentas = "" Or rutaComparativa = "" Or rutaPreciosNetos = "" Then
        MsgBox "Importe todos los archivos necesarios.", vbExclamation
        Exit Sub
    End If
    
    Application.StatusBar = "Procesando datos para el cliente " & nombreCliente & " (" & clienteSeleccionado & ")..."
    Application.ScreenUpdating = False
    
    Call CalcularKPIs
    Call GenerarRecomendaciones
    Call CalcularAnalisisAvanzado
    Call ActualizarDashboard
    
    Application.StatusBar = False
    Application.ScreenUpdating = True
    MsgBox "Procesamiento completado y dashboard actualizado.", vbInformation
End Sub

